# Jira adapter core settings
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_DEPLOYMENT_TYPE=cloud
JIRA_AUTH_MODE=api_token

# Auth values (choose based on JIRA_AUTH_MODE)
JIRA_EMAIL=jira-user@example.com
JIRA_API_TOKEN=replace-with-token
JIRA_PAT=
JIRA_BEARER_TOKEN=

# Runtime behavior
JIRA_TIMEOUT_SECONDS=30
JIRA_RETRY_MAX_ATTEMPTS=3
JIRA_RETRY_INITIAL_DELAY_SECONDS=0.25
JIRA_RETRY_MAX_DELAY_SECONDS=3.0
JIRA_RETRY_BACKOFF_MULTIPLIER=2.0
JIRA_RETRY_STATUSES=408,429,500,502,503,504

# Pagination bounds
JIRA_PAGE_SIZE=50
JIRA_MAX_PAGES=20
JIRA_MAX_PAGE_SIZE=100

# Issue mapping
JIRA_FALLBACK_ISSUE_TYPE=Task
JIRA_ISSUE_TYPE_OVERRIDES=User Story:Story,Defect:Bug
